---
import Layout from "../layouts/Layout.astro";
import HotRod from "../components/HotRod.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (p) => (base + p) || "/";

const styles = [
  { name: "Hot Rods", note: "Flamed, chopped, and ready to launch." },
  { name: "Muscle", note: "Big block attitude, bigger personality." },
  { name: "Rat Rods", note: "Rusty, raw, and full of character." },
  { name: "Trucks", note: "Work trucks and haulers with a grin." },
  { name: "Bikes", note: "Two wheels, loud pipes, pure toon." },
  { name: "You, Driving It", note: "Caricatures of you behind the wheel." },
];

const steps = [
  { n: "01", t: "Send your ride", d: "Email a few photos of your car, truck, or bike. Any angle works. Tell me what makes it yours." },
  { n: "02", t: "I sketch it loud", d: "I draw it by hand in the Nitro Toonz style. Flames, big wheels, and all the attitude your ride deserves." },
  { n: "03", t: "You get the art", d: "A finished cartoon of your pride and joy, ready to print, frame, or show off online." },
];
---
<Layout active="Home" title="Nitro Toonz">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-halftone" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div class="hero-copy rise">
        <p class="eyebrow">Custom hot rod cartoon art</p>
        <h1>Your ride,<br/><span class="hl">drawn loud.</span></h1>
        <p class="hero-sub">
          I take a photo of your hot rod, muscle car, or truck and turn it into a
          one-of-a-kind cartoon with all the flames and attitude it was built for.
          That is the whole idea behind Nitro Toonz. I cartoon your imagination.
        </p>
        <div class="hero-btns">
          <a class="btn btn-flame" href={href("/commissions")}><span>Get your ride toon'd</span></a>
          <a class="btn btn-ghost" href={href("/garage")}><span>See the garage</span></a>
        </div>
      </div>
      <div class="hero-art rise">
        <HotRod cls="hero-rod" />
      </div>
    </div>
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        <span>HOT RODS</span><span class="dot">&bull;</span><span>MUSCLE CARS</span><span class="dot">&bull;</span>
        <span>RAT RODS</span><span class="dot">&bull;</span><span>TRUCKS</span><span class="dot">&bull;</span>
        <span>CARICATURES</span><span class="dot">&bull;</span>
        <span>HOT RODS</span><span class="dot">&bull;</span><span>MUSCLE CARS</span><span class="dot">&bull;</span>
        <span>RAT RODS</span><span class="dot">&bull;</span><span>TRUCKS</span><span class="dot">&bull;</span>
        <span>CARICATURES</span><span class="dot">&bull;</span>
      </div>
    </div>
  </section>

  <!-- WHAT I DRAW -->
  <section class="styles wrap">
    <div class="sec-head rise">
      <p class="eyebrow">What rolls out of the shop</p>
      <h2>If it has wheels, I can toon it.</h2>
    </div>
    <div class="style-grid">
      {styles.map((s) => (
        <article class="style-card rise">
          <h3>{s.name}</h3>
          <p>{s.note}</p>
          <span class="card-rivet" aria-hidden="true"></span>
        </article>
      ))}
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="how">
    <div class="wrap">
      <div class="sec-head rise">
        <p class="eyebrow">How it works</p>
        <h2>From photo to cartoon in three gears.</h2>
      </div>
      <div class="step-grid">
        {steps.map((s) => (
          <article class="step rise">
            <span class="step-num">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="wrap cta-inner rise">
      <h2>Got a ride worth drawing?</h2>
      <p>Let's put it on paper with the volume turned all the way up.</p>
      <a class="btn btn-flame" href={href("/commissions")}><span>Start a commission</span></a>
    </div>
  </section>

  <style>
    .hero { position: relative; overflow: hidden; padding: clamp(2rem, 6vw, 4.5rem) 0 0; background: radial-gradient(120% 80% at 70% 0%, #221a16 0%, var(--ink) 60%); }
    .hero-halftone { position: absolute; inset: 0; background-image: radial-gradient(#ff5a1f 1px, transparent 1.4px); background-size: 22px 22px; opacity: 0.06; pointer-events: none; }
    .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 2rem; align-items: center; }
    .hl { color: var(--flame); -webkit-text-stroke: 2px var(--flame-deep); }
    .hero-sub { font-size: 1.15rem; color: var(--chrome); max-width: 34ch; margin-top: 1rem; }
    .hero-btns { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.8rem; }
    .hero-rod { width: 100%; height: auto; filter: drop-shadow(0 18px 24px rgba(0,0,0,0.5)); animation: idle 4s ease-in-out infinite; }
    @keyframes idle { 0%,100% { transform: translateY(0) rotate(-0.4deg); } 50% { transform: translateY(-8px) rotate(0.4deg); } }
    @media (prefers-reduced-motion: reduce) { .hero-rod { animation: none; } }

    .marquee { margin-top: 2.5rem; background: var(--flame); color: var(--ink); overflow: hidden; border-top: 3px solid var(--flame-deep); border-bottom: 3px solid var(--flame-deep); }
    .marquee-track { display: inline-flex; gap: 1.2rem; align-items: center; white-space: nowrap; font-family: var(--font-display); font-size: 1.5rem; letter-spacing: 1px; padding: 0.5rem 0; animation: slide 22s linear infinite; }
    .marquee-track .dot { color: var(--flame-deep); }
    @keyframes slide { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    @media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }

    .sec-head { margin: clamp(2.5rem, 6vw, 4.5rem) 0 2rem; max-width: 24ch; }
    .styles { padding-top: 1rem; }
    .style-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.2rem; }
    .style-card { position: relative; background: linear-gradient(180deg, var(--ink-3), var(--ink-2)); border: 2px solid #2a2320; border-radius: 4px; padding: 1.6rem 1.5rem; transition: transform .18s, border-color .18s; }
    .style-card:hover { transform: translateY(-5px) skewX(-1deg); border-color: var(--flame); }
    .style-card h3 { color: var(--bone); }
    .style-card p { color: var(--smoke); margin: 0.6rem 0 0; font-size: 1rem; }
    .card-rivet { position: absolute; top: 12px; right: 12px; width: 10px; height: 10px; border-radius: 50%; background: radial-gradient(var(--chrome), #5a5a5a); box-shadow: 0 0 0 2px #0006; }

    .how { background: var(--ink-2); border-top: 2px solid var(--ink-3); border-bottom: 2px solid var(--ink-3); padding-bottom: clamp(2.5rem, 6vw, 4rem); margin-top: clamp(2.5rem, 6vw, 4rem); }
    .step-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.4rem; }
    .step { position: relative; padding: 1.8rem 1.6rem; background: var(--ink); border-radius: 4px; border-left: 5px solid var(--flame); }
    .step-num { font-family: var(--font-slab); font-size: 1.6rem; color: var(--flame); display: block; margin-bottom: 0.6rem; }
    .step h3 { color: var(--bone); }
    .step p { color: var(--smoke); margin-top: 0.5rem; font-size: 1rem; }

    .cta { padding: clamp(3rem, 8vw, 5rem) 0; text-align: center; background: repeating-linear-gradient(-45deg, #17110e 0 40px, #140f0d 40px 80px); }
    .cta-inner h2 { color: var(--bone); }
    .cta-inner p { color: var(--chrome); font-size: 1.15rem; margin: 0.8rem 0 1.6rem; }

    @media (max-width: 820px) {
      .hero-grid { grid-template-columns: 1fr; }
      .hero-art { order: -1; max-width: 460px; }
      .hero-sub { max-width: none; }
    }
  </style>
</Layout>
