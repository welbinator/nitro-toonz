---
import Layout from "../layouts/Layout.astro";
const href = (import.meta.env.BASE_URL.replace(/\/$/, "")) || "/";
---
<Layout title="Page not found">
  <section class="wrap nf">
    <p class="eyebrow">404</p>
    <h1>This road's a dead end.</h1>
    <p>The page you were after spun out. Let's get you back on track.</p>
    <a class="btn btn-flame" href={href}><span>Back to the shop</span></a>
  </section>
  <style>
    .nf { text-align: center; padding: clamp(3rem, 10vw, 7rem) 0; }
    .nf p { color: var(--chrome); font-size: 1.15rem; margin: 1rem 0 1.6rem; }
  </style>
</Layout>
